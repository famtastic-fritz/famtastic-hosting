# GoDaddy Reseller API
# Get from https://developer.godaddy.com/keys
GODADDY_API_KEY=your_api_key_here
GODADDY_API_SECRET=your_api_secret_here
GODADDY_API_BASE=https://api.godaddy.com/v1

# MySQL
# Connection details for the hosting dashboard database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=famtastic_hosting
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here

# Session
# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here

# Email / Contact Form
# Resend API key for transactional emails
# NOTE: cPanel SMTP is preferred for outbound mail when available
RESEND_API_KEY=re_your_key_here

# cPanel SMTP (preferred for outbound mail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@famtastichosting.com

# Site Configuration
SITE_URL=https://famtastichosting.com