# GoDaddy Reseller API
# Get from https://developer.godaddy.com/keys
GODADDY_API_KEY=your_api_key_here
GODADDY_API_SECRET=your_api_secret_here
GODADDY_API_BASE=https://api.godaddy.com/v1

# Supabase
# Get from https://supabase.com/dashboard
# PUBLIC_ prefix = safe for browser bundles (anon key only)
# SUPABASE_SERVICE_ROLE_KEY has no PUBLIC_ prefix — must NEVER reach the client
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret (Supabase handles this internally)
JWT_SECRET=your_jwt_secret_here

# Email / Contact Form
# Resend API key for sending emails
RESEND_API_KEY=re_your_key_here

# Site Configuration
SITE_URL=https://famtastichosting.com

# Optional: Email settings if using SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@famtastichosting.com

# Optional: Database URL for direct connections
DATABASE_URL=postgresql://user:password@localhost:5432/famtastic_hosting
