---
// ThemeToggle.astro — Unified theme toggle for all layouts
// Place this in src/components/ThemeToggle.astro
---
<button
  id="themeToggle"
  class="theme-toggle"
  aria-label="Toggle theme"
  title="Toggle Purple / Hacker theme"
>
  <span class="theme-label-purple">PURPLE</span>
  <div class="theme-switch">
    <div class="theme-knob"></div>
  </div>
  <span class="theme-label-hacker">HACKER</span>
</button>

<style is:global>
  /* ─── THEME TOGGLE STYLES ───────────────────────────────────── */
  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    background: rgba(8, 8, 8, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: 100px;
    cursor: pointer;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted, #9090a0);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .theme-toggle:hover {
    border-color: rgba(124, 58, 237, 0.6);
    box-shadow: 0 0 20px rgba(124, 58, 237, 0.15);
  }
  [data-theme="hacker"] .theme-toggle {
    border-color: rgba(0, 255, 65, 0.3);
    background: rgba(0, 0, 0, 0.9);
    font-family: var(--font-term, 'Share Tech Mono', monospace);
  }
  [data-theme="hacker"] .theme-toggle:hover {
    border-color: rgba(0, 255, 65, 0.6);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.15);
  }

  .theme-switch {
    width: 44px;
    height: 22px;
    background: var(--surface, #111114);
    border: 1px solid var(--border, #2a2a38);
    border-radius: 11px;
    position: relative;
    transition: background 0.3s, border-color 0.3s;
  }
  [data-theme="hacker"] .theme-switch {
    background: rgba(0, 255, 65, 0.1);
    border-color: rgba(0, 255, 65, 0.3);
  }

  .theme-knob {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--violet, #7c3aed);
    position: absolute;
    top: 2px;
    left: 2px;
    transition: transform 0.3s, background 0.3s;
    box-shadow: 0 0 8px rgba(124, 58, 237, 0.4);
  }
  [data-theme="hacker"] .theme-knob {
    transform: translateX(22px);
    background: var(--green, #00ff41);
    box-shadow: 0 0 8px rgba(0, 255, 65, 0.4);
  }

  .theme-label-purple {
    color: var(--violet, #7c3aed);
    font-weight: 700;
    transition: color 0.3s, opacity 0.3s;
  }
  [data-theme="hacker"] .theme-label-purple {
    color: var(--muted, #9090a0);
    font-weight: 400;
    opacity: 0.5;
  }

  .theme-label-hacker {
    color: var(--muted, #9090a0);
    font-weight: 400;
    opacity: 0.5;
    transition: color 0.3s, opacity 0.3s;
  }
  [data-theme="hacker"] .theme-label-hacker {
    color: var(--green, #00ff41);
    font-weight: 700;
    opacity: 1;
  }

  /* ─── THEME VARIABLES (overrides in global.css) ────────────── */
  :root {
    --theme-mode: 'purple';
  }
  [data-theme="hacker"] {
    --theme-mode: 'hacker';
  }
</style>

<script is:inline>
  // Theme toggle logic — runs immediately, before hydration
  (function() {
    const STORAGE_KEY = 'famtastic-theme';
    const html = document.documentElement;
    
    // 1. Apply saved theme immediately (prevents flash)
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === 'hacker' || saved === 'purple') {
      html.setAttribute('data-theme', saved);
    }
    
    // 2. Wire up the toggle button
    function initToggle() {
      const btn = document.getElementById('themeToggle');
      if (!btn) return;
      
      btn.addEventListener('click', function() {
        const current = html.getAttribute('data-theme') || 'purple';
        const next = current === 'purple' ? 'hacker' : 'purple';
        html.setAttribute('data-theme', next);
        localStorage.setItem(STORAGE_KEY, next);
      });
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initToggle);
    } else {
      initToggle();
    }
  })();
</script>
