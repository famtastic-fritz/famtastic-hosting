---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import CartButton from '../components/CartButton.svelte'
import '../styles/global.css'
import '../styles/wild.css'
import '../styles/extreme.css'
import '../styles/components.css'
import '../styles/theme-core.css'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  defaultTheme?: 'purple' | 'hacker'
}
const { title, description, canonicalPath = '', defaultTheme = 'purple' } = Astro.props
const canonical = `https://famtastichosting.com${canonicalPath}`
const currentPath = Astro.url.pathname

const hackerLinks = [
  { href: '/wordpress', label: './wordpress' },
  { href: '/hosting', label: './hosting' },
  { href: '/builder', label: './builder' },
  { href: '/servers', label: './servers' },
  { href: '/domains', label: './domains' },
  { href: '/bundles', label: './bundles' },
]
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FAMtastic Hosting",
    "url": "https://famtastichosting.com",
    "email": "hello@famtastichosting.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Miami", "addressRegion": "FL" }
  })} />
</head>
<body>
  <script is:inline data-default-theme={defaultTheme}>
    (function() {
      const saved = localStorage.getItem('famtastic-theme');
      const defaultTheme = document.currentScript.dataset.defaultTheme || 'purple';
      if (saved === 'hacker' || saved === 'purple') {
        document.documentElement.setAttribute('data-theme', saved);
      } else {
        document.documentElement.setAttribute('data-theme', defaultTheme);
      }
    })();
  </script>

  <ThemeToggle />

  <!-- CRT scanlines overlay (visible in hacker mode) -->
  <div class="crt-scanlines" aria-hidden="true"></div>
  <!-- Blend overlay (visible in hacker mode) -->
  <div class="blend-overlay" aria-hidden="true"></div>
  <!-- Matrix rain container (visible in hacker mode) -->
  <div id="matrixRain" class="matrix-rain" aria-hidden="true"></div>

  <!-- Purple nav (hidden in hacker mode) -->
  <div class="purple-only">
    <Nav />
  </div>

  <!-- Hacker nav (hidden in purple mode) -->
  <div class="hacker-only">
    <nav class="nav-bar" role="navigation" aria-label="Main navigation">
      <div class="nav-logo" data-text="FAMtastic_Hosting">
        <a href="/" style="color:var(--green);text-decoration:none;">FAMtastic</a><span style="opacity:0.5;color:var(--green);">_Hosting</span>
      </div>
      <ul class="nav-links" style="list-style:none;">
        {hackerLinks.map(l => (
          <li><a href={l.href} class="ext-nav-link" style={currentPath === l.href ? 'color:var(--green);' : ''}>{l.label}</a></li>
        ))}
      </ul>
      <div class="hacker-nav-actions">
        <a href="/dashboard/login" class="hacker-signin">sign-in</a>
        <CartButton client:load />
        <a href="/contact" class="btn-primary"><span>Talk to a Human</span></a>
      </div>
    </nav>
  </div>

  <main>
    <slot />
  </main>

  <!-- Purple footer (hidden in hacker mode) -->
  <div class="purple-only">
    <Footer />
  </div>

  <!-- Hacker footer (hidden in purple mode) -->
  <footer class="hacker-only ext-footer">
    <div class="ext-footer-copy">FAMtastic Hosting &copy; {new Date().getFullYear()} &mdash; All systems operational.</div>
    <nav style="display:flex;gap:1.5rem;flex-wrap:wrap;" aria-label="Footer navigation">
      <a href="/" style="font-family:var(--font-term);font-size:0.72rem;color:rgba(0,255,65,0.35);">./home</a>
      <a href="/wordpress" style="font-family:var(--font-term);font-size:0.72rem;color:rgba(0,255,65,0.35);">./wordpress</a>
      <a href="/hosting" style="font-family:var(--font-term);font-size:0.72rem;color:rgba(0,255,65,0.35);">./hosting</a>
      <a href="/bundles" style="font-family:var(--font-term);font-size:0.72rem;color:rgba(0,255,65,0.35);">./bundles</a>
      <a href="https://famtasticdesigns.com" style="font-family:var(--font-term);font-size:0.72rem;color:rgba(0,255,65,0.35);">./designs</a>
    </nav>
    <div style="width:100%;font-family:var(--font-term);font-size:0.55rem;color:rgba(0,255,65,0.2);margin-top:0.5rem;">
      Domain registration fulfilled through WildWestDomains.com, an ICANN-accredited registrar.
    </div>
  </footer>

  <script>
    // FAQ accordion
    document.querySelectorAll('.faq-q').forEach(q => {
      q.addEventListener('click', () => {
        q.classList.toggle('open');
        const a = q.nextElementSibling as HTMLElement | null;
        if (a) a.classList.toggle('open');
      });
    });
    // Stat row fade-in
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.opacity = '1';
          (e.target as HTMLElement).style.transform = 'translateX(0)';
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.2 });
    document.querySelectorAll<HTMLElement>('.stat-row').forEach((row, i) => {
      row.style.opacity = '0';
      row.style.transform = 'translateX(-30px)';
      row.style.transition = `opacity 0.6s ease ${i * 0.12}s, transform 0.6s ease ${i * 0.12}s`;
      obs.observe(row);
    });
    // Card deck hover
    const cards = document.querySelectorAll<HTMLElement>('.plan-card');
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => cards.forEach(c => { if (c !== card) c.style.opacity = '0.6'; }));
      card.addEventListener('mouseleave', () => cards.forEach(c => c.style.opacity = ''));
    });
    // Smooth scroll
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const t = document.querySelector(a.getAttribute('href') || '');
        if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
      });
    });
    // Matrix rain
    (function() {
      const container = document.getElementById('matrixRain');
      if (!container) return;
      // Only run in hacker mode
      if (document.documentElement.getAttribute('data-theme') !== 'hacker') return;
      const chars = '01アイウエオカキクケコサシスセソ▓▒░█▄▀FAMtastic'.split('');
      const cols = Math.floor(window.innerWidth / 20);
      for (let i = 0; i < cols; i++) {
        const col = document.createElement('div');
        col.className = 'matrix-col';
        let txt = '';
        for (let j = 0; j < 10 + Math.floor(Math.random() * 20); j++) {
          txt += chars[Math.floor(Math.random() * chars.length)] + '\n';
        }
        col.textContent = txt;
        col.style.left = (i * 20) + 'px';
        col.style.animationDuration = (6 + Math.random() * 14) + 's';
        col.style.animationDelay = (Math.random() * -20) + 's';
        col.style.opacity = String(0.04 + Math.random() * 0.1);
        container.appendChild(col);
      }
    })();
    // Typewriter lines
    document.querySelectorAll<HTMLElement>('.prompt-line').forEach(line => {
      const delay = parseFloat(line.style.getPropertyValue('--tw-delay') || '0') * 1000;
      setTimeout(() => {
        line.style.width = '100%';
        line.style.opacity = '1';
      }, delay);
    });
  </script>
</body>
</html>
