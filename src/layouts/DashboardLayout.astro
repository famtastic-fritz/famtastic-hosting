---
/**
 * DashboardLayout.astro
 *
 * Wraps all dashboard and admin pages. Imports the dashboard design system,
 * sets up the PageShell with sidebar nav, and exports TypeScript-typed props.
 *
 * Usage:
 *   <DashboardLayout
 *     title="My Domains"
 *     variant="customer"
 *     currentPath="/dashboard/domains"
 *     userName="Jane Smith"
 *   >
 *     <slot />
 *   </DashboardLayout>
 *
 * For admin pages, set variant="admin" and use /admin/** paths.
 */

import PageShell from '../components/dashboard/PageShell.svelte'
import '../styles/global.css'
import '../styles/dashboard.css'

export type DashboardVariant = 'customer' | 'admin'

interface Props {
  title: string
  description?: string
  variant?: DashboardVariant
  currentPath?: string
  userName?: string
  userId?: number
  canonicalPath?: string
}

const {
  title,
  description = 'FAMtastic Hosting — Manage your hosting, domains, and email.',
  variant = 'customer',
  currentPath = '/dashboard',
  userName = '',
  userId = 0,
  canonicalPath = '',
} = Astro.props

const canonical = `https://famtastichosting.com${canonicalPath}`
const bodyBg    = '#0a0a0f'
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — FAMtastic Hosting</title>
  <meta name="description" content={description} />
  {canonicalPath && <link rel="canonical" href={canonical} />}
  <!-- Dashboard pages are not indexed -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0a0a0f" />
  <!-- Open Graph (for share previews if admin ever shares a link) -->
  <meta property="og:title" content={`${title} — FAMtastic Hosting`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body style={`background:${bodyBg};color:#f5f5f0;font-family:'DM Sans',sans-serif;`}>
  <!--
    PageShell is a Svelte component island. It manages:
    - DashboardNav (sidebar, fully responsive with hamburger on mobile)
    - Topbar with phone number + user avatar
    - Main content area slot
    client:load ensures hydration on page load for interactive hamburger/sidebar
  -->
  <PageShell
    client:load
    {variant}
    {currentPath}
    pageTitle={title}
    {userName}
    {userId}
  >
    <slot />
  </PageShell>

  <script>
    // Skip-to-main accessibility anchor
    const main = document.getElementById('main-content')
    if (main && !document.getElementById('skip-link')) {
      const skip = document.createElement('a')
      skip.id = 'skip-link'
      skip.href = '#main-content'
      skip.textContent = 'Skip to content'
      skip.style.cssText = [
        'position:fixed', 'top:-100%', 'left:16px', 'z-index:9999',
        'background:#7c3aed', 'color:#fff', 'padding:8px 16px',
        'border-radius:0 0 8px 8px', 'font-size:0.875rem',
        'transition:top 0.15s ease', 'text-decoration:none',
      ].join(';')
      skip.addEventListener('focus', () => { skip.style.top = '0' })
      skip.addEventListener('blur',  () => { skip.style.top = '-100%' })
      document.body.insertBefore(skip, document.body.firstChild)
    }
  </script>
</body>
</html>
