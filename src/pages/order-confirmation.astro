---
export const prerender = false;

import UnifiedLayout from '../layouts/UnifiedLayout.astro';

const url   = new URL(Astro.request.url);
const orderId   = url.searchParams.get('orderId')   ?? '';
const amount    = url.searchParams.get('amount')    ?? '';
const paypalRef = url.searchParams.get('paypal')    ?? '';
---

<UnifiedLayout
  title="Order Confirmed — FAMtastic Hosting"
  description="Your FAMtastic Hosting order was received. We'll be in touch shortly."
>
  <main class="confirm-page">
    <div class="confirm-container">
      <div class="confirm-icon" aria-hidden="true">✓</div>
      <h1 class="confirm-title">You're all set!</h1>
      <p class="confirm-sub">
        Your payment was received. We're reviewing your order and will provision
        your services within 1–2 business hours.
      </p>

      <div class="confirm-card">
        {orderId && (
          <div class="confirm-row">
            <span class="confirm-label">Order #</span>
            <span class="confirm-value">{orderId}</span>
          </div>
        )}
        {amount && (
          <div class="confirm-row">
            <span class="confirm-label">Amount paid</span>
            <span class="confirm-value">${amount} USD</span>
          </div>
        )}
        {paypalRef && (
          <div class="confirm-row">
            <span class="confirm-label">PayPal reference</span>
            <span class="confirm-value confirm-value--mono">{paypalRef}</span>
          </div>
        )}
      </div>

      <p class="confirm-help">
        Questions? <a href="/contact" class="confirm-link">Contact us</a> or email
        <a href="mailto:hello@famtastichosting.com" class="confirm-link">hello@famtastichosting.com</a>.
      </p>

      <a href="/dashboard" class="btn-primary">Go to My Dashboard</a>
    </div>
  </main>
</UnifiedLayout>

<style>
  .confirm-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: #07070f;
  }

  .confirm-container {
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .confirm-icon {
    width: 64px;
    height: 64px;
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .confirm-title {
    font-size: 2rem;
    font-weight: 700;
    color: #f5f5f7;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .confirm-sub {
    color: #8e8ea0;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .confirm-card {
    background: #12121e;
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .confirm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #1e1e2e;
    font-size: 0.9rem;
  }

  .confirm-row:last-child { border-bottom: none; }

  .confirm-label {
    color: #8e8ea0;
  }

  .confirm-value {
    color: #f5f5f7;
    font-weight: 600;
  }

  .confirm-value--mono {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    word-break: break-all;
  }

  .confirm-help {
    color: #8e8ea0;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .confirm-link {
    color: #7c3aed;
    text-decoration: none;
  }

  .confirm-link:hover { text-decoration: underline; }

  .btn-primary {
    display: inline-block;
    background: #7c3aed;
    color: #fff;
    padding: 0.875rem 2.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: #6d28d9; }
</style>
