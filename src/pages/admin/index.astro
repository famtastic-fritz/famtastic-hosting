---
/**
 * /admin — Revenue Dashboard (Admin command center)
 *
 * Fetches revenue, order, and subscription data server-side from
 * /api/admin/revenue and renders the initial view. The RevenueChart Svelte
 * island hydrates client-side for the interactive bar chart.
 *
 * Auth: requireAdmin() — non-admin users redirect to /admin/login.
 */
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../lib/auth/middleware.js';
import RevenueChart from '../../components/dashboard/RevenueChart.svelte';

// Auth gate
const auth = await requireAdmin(Astro.request);
if (auth instanceof Response) return auth;

// Fetch revenue data from our own API route (server-to-server)
let revenueData: {
  mtd: { revenueUSD: number; orderCount: number };
  byCategory: Array<{ category: string; revenueUSD: number }>;
  monthlyRevenue: Array<{ month: string; revenueUSD: number }>;
  subscriptions: { active: number; mrrEstimateUSD: number };
  recentOrders: Array<{
    orderId: number;
    createdAt: string;
    totalUSD: number;
    items: Array<{ label: string; quantity: number; unitPriceUSD: number }>;
  }>;
} | null = null;

let revenueError = '';

try {
  const origin = new URL(Astro.request.url).origin;
  const res = await fetch(`${origin}/api/admin/revenue`, {
    headers: { Cookie: Astro.request.headers.get('Cookie') ?? '' },
  });
  if (res.ok) {
    const json = await res.json();
    revenueData = json.data;
  } else {
    revenueError = 'Revenue data unavailable — GoDaddy API credentials may not be configured.';
  }
} catch {
  revenueError = 'Unable to connect to revenue service.';
}

function formatUSD(n: number): string {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n);
}

function formatMonth(yyyymm: string): string {
  const [y, m] = yyyymm.split('-');
  return new Date(Number(y), Number(m) - 1, 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const now = new Date();
const mtdLabel = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<DashboardLayout
  title="Revenue Dashboard"
  variant="admin"
  currentPath="/admin"
  userName={auth.email}
>
  <!-- Page header -->
  <div class="db-page-header">
    <div class="db-page-header__row">
      <div>
        <h2 class="db-page-title">Revenue Dashboard</h2>
        <p class="db-page-subtitle">Month-to-date for {mtdLabel} &mdash; FAMtastic Hosting command center</p>
      </div>
      <div class="header-actions">
        <a href="/admin/reports" class="db-btn db-btn--secondary db-btn--sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          Export Reports
        </a>
        <a href="/admin/orders" class="db-btn db-btn--primary db-btn--sm">View All Orders</a>
      </div>
    </div>
  </div>

  {revenueError && (
    <div class="db-alert db-alert--warning" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01"/>
      </svg>
      <span>{revenueError}</span>
    </div>
  )}

  <!-- MTD Stat Cards -->
  <div class="db-grid db-grid--stats db-mb-6">
    <div class="db-stat-card">
      <div class="db-stat-card__label">MTD Revenue</div>
      <div class="db-stat-card__value">
        {revenueData ? formatUSD(revenueData.mtd.revenueUSD) : '—'}
      </div>
      <div class="db-stat-card__delta db-stat-card__delta--flat">
        {revenueData ? `${revenueData.mtd.orderCount} orders this month` : 'GoDaddy API required'}
      </div>
    </div>

    <div class="db-stat-card">
      <div class="db-stat-card__label">Active Subscriptions</div>
      <div class="db-stat-card__value">
        {revenueData ? revenueData.subscriptions.active.toLocaleString() : '—'}
      </div>
      <div class="db-stat-card__delta db-stat-card__delta--flat">Tracked in Supabase</div>
    </div>

    <div class="db-stat-card">
      <div class="db-stat-card__label">MRR Estimate</div>
      <div class="db-stat-card__value">
        {revenueData ? formatUSD(revenueData.subscriptions.mrrEstimateUSD) : '—'}
      </div>
      <div class="db-stat-card__delta db-stat-card__delta--flat">Based on retail pricing</div>
    </div>

    <div class="db-stat-card">
      <div class="db-stat-card__label">Support Line</div>
      <div class="db-stat-card__value stat-phone">
        <a href="tel:+14806242500" class="phone-link">(480) 624-2500</a>
      </div>
      <div class="db-stat-card__delta db-stat-card__delta--flat">GoDaddy white-label 24/7</div>
    </div>
  </div>

  <!-- Revenue Chart (Svelte island) + Category Breakdown -->
  <div class="db-grid db-grid--2 db-mb-6">
    {revenueData && (
      <RevenueChart
        client:load
        monthlyRevenue={revenueData.monthlyRevenue}
        title="Revenue — Last 12 Months"
      />
    )}
    {!revenueData && (
      <div class="db-chart chart-placeholder">
        <div class="db-chart__header">
          <div>
            <p class="db-chart__title">Revenue — Last 12 Months</p>
            <p class="db-chart__subtitle">Configure GoDaddy API credentials to see chart data</p>
          </div>
        </div>
        <div class="empty-chart-area">
          <span class="db-text-muted db-text-sm">No data available</span>
        </div>
      </div>
    )}

    <!-- Revenue by category -->
    <div class="db-card">
      <div class="db-card__header">
        <h3 class="db-card__title">Revenue by Category</h3>
        <span class="db-card__meta">Last 12 months</span>
      </div>
      {revenueData && revenueData.byCategory.length > 0 ? (
        <div class="category-list">
          {revenueData.byCategory.slice(0, 8).map(cat => (
            <div class="category-row">
              <div class="category-row__name db-truncate">{cat.category}</div>
              <div class="category-row__bar-wrap">
                <div
                  class="category-row__bar"
                  style={`width:${Math.round((cat.revenueUSD / revenueData.byCategory[0].revenueUSD) * 100)}%`}
                ></div>
              </div>
              <div class="category-row__value">{formatUSD(cat.revenueUSD)}</div>
            </div>
          ))}
        </div>
      ) : (
        <p class="db-text-muted db-text-sm">No category data yet.</p>
      )}
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="db-section">
    <div class="db-flex-between db-mb-4">
      <h3 class="db-section-title" style="margin:0;border:0;padding:0;">Recent Orders</h3>
      <a href="/admin/orders" class="db-btn db-btn--ghost db-btn--sm">View all orders →</a>
    </div>

    {revenueData && revenueData.recentOrders.length > 0 ? (
      <div class="db-table-wrapper">
        <table class="db-table" aria-label="Recent orders">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Date</th>
              <th>Products</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {revenueData.recentOrders.map(order => (
              <tr>
                <td>
                  <span class="db-text-mono db-text-sm">#{order.orderId}</span>
                </td>
                <td>
                  <span class="db-text-sm db-text-secondary">
                    {new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </td>
                <td>
                  <span class="db-text-sm">
                    {order.items.map(i => i.label).join(', ')}
                  </span>
                </td>
                <td>
                  <span class="db-text-heading" style="font-weight:600;">{formatUSD(order.totalUSD)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="db-card">
        <p class="db-text-muted db-text-sm">
          {revenueData ? 'No recent orders.' : 'Order data requires GoDaddy API credentials.'}
        </p>
      </div>
    )}
  </div>
</DashboardLayout>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Phone in stat card */
  .stat-phone {
    font-size: 1.25rem !important;
  }

  .phone-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .phone-link:hover {
    color: #22c55e;
  }

  /* Category breakdown */
  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .category-row {
    display: grid;
    grid-template-columns: 90px 1fr 80px;
    align-items: center;
    gap: 0.75rem;
  }

  .category-row__name {
    font-size: 0.8125rem;
    color: var(--db-text-secondary);
    text-transform: capitalize;
  }

  .category-row__bar-wrap {
    height: 6px;
    background: var(--db-bg-input);
    border-radius: 9999px;
    overflow: hidden;
  }

  .category-row__bar {
    height: 100%;
    background: var(--db-violet-mid);
    border-radius: 9999px;
    min-width: 4px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .category-row__value {
    font-family: var(--db-font-mono);
    font-size: 0.75rem;
    color: var(--db-text-primary);
    text-align: right;
  }

  /* Empty chart placeholder */
  .chart-placeholder {
    min-height: 200px;
    display: flex;
    flex-direction: column;
  }

  .empty-chart-area {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .header-actions {
      width: 100%;
    }
  }
</style>
