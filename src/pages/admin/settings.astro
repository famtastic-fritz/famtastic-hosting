---
/**
 * /admin/settings — Admin settings
 *
 * - Support phone number (currently (480) 624-2500)
 * - Admin email notification preferences (stored in admin_settings table)
 * - API key management (last 4 chars only — no exposure of full keys)
 *
 * Reads from admin_settings table in Supabase.
 * Writes via inline form → POST /api/admin/settings (future endpoint).
 *
 * Auth: requireAdmin()
 */
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { requireAdmin } from '../../lib/auth/middleware.js';
import { supabaseAdmin } from '../../lib/supabase/client.js';

const auth = await requireAdmin(Astro.request);
if (auth instanceof Response) return auth;

// Load admin settings from Supabase
const { data: settingsRows } = await supabaseAdmin
  .from('admin_settings')
  .select('key, value');

const settings: Record<string, string> = {};
if (settingsRows) {
  for (const row of settingsRows) {
    settings[row.key] = row.value;
  }
}

const supportPhone = settings['support_phone'] ?? '(480) 624-2500';
const notifyEmail = settings['notify_email'] ?? auth.email;
const notifyOnOrder = settings['notify_on_order'] !== 'false';
const notifyOnProvisioning = settings['notify_on_provisioning'] !== 'false';

// Mask GoDaddy key — show only last 4 chars
const rawApiKey = import.meta.env.GODADDY_API_KEY ?? '';
const maskedKey = rawApiKey.length > 4
  ? '•'.repeat(12) + rawApiKey.slice(-4)
  : rawApiKey ? '•'.repeat(rawApiKey.length) : 'Not configured';
---

<DashboardLayout
  title="Settings"
  variant="admin"
  currentPath="/admin/settings"
  userName={auth.email}
>
  <div class="db-page-header">
    <div class="db-page-header__row">
      <div>
        <h2 class="db-page-title">Settings</h2>
        <p class="db-page-subtitle">Configure support details, notifications, and API key visibility.</p>
      </div>
    </div>
  </div>

  <!-- Save feedback toast -->
  <div class="save-toast" id="save-toast" role="status" aria-live="polite" hidden></div>

  <!-- Support Phone -->
  <div class="db-section">
    <h3 class="db-section-title">Support</h3>
    <div class="db-card">
      <div class="settings-row">
        <div class="settings-row__info">
          <h4 class="settings-row__label">Support Phone Number</h4>
          <p class="settings-row__desc">
            GoDaddy white-label support number. Displayed on every dashboard page and in the customer portal.
            This number is required by the reseller agreement.
          </p>
        </div>
        <div class="settings-row__control">
          <div class="phone-display">
            <a href={`tel:${supportPhone.replace(/\D/g, '')}`} class="phone-number">{supportPhone}</a>
            <span class="db-badge db-badge--active">Active</span>
          </div>
          <p class="db-help-text db-mt-4">
            To change this number, update the <code>support_phone</code> key in the <code>admin_settings</code> table in Supabase,
            or contact GoDaddy reseller support to update your white-label number.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Notifications -->
  <div class="db-section">
    <h3 class="db-section-title">Notifications</h3>
    <div class="db-card">
      <form id="notifications-form" novalidate>

        <div class="settings-row settings-row--stacked">
          <div class="settings-row__info">
            <h4 class="settings-row__label">Admin Email</h4>
            <p class="settings-row__desc">Where order and provisioning alerts are sent.</p>
          </div>
          <div class="settings-row__control">
            <div class="db-form-group" style="margin:0;">
              <input
                type="email"
                class="db-input"
                id="notify-email"
                name="notify_email"
                value={notifyEmail}
                placeholder="admin@famtastichosting.com"
                autocomplete="email"
              />
            </div>
          </div>
        </div>

        <hr class="db-divider" />

        <div class="settings-row settings-row--stacked">
          <div class="settings-row__info">
            <h4 class="settings-row__label">Email Alerts</h4>
            <p class="settings-row__desc">Choose which events trigger an admin notification.</p>
          </div>
          <div class="settings-row__control">
            <div class="toggle-list">
              <label class="toggle-item">
                <span class="toggle-item__label">New order received</span>
                <input
                  type="checkbox"
                  class="toggle-checkbox"
                  name="notify_on_order"
                  checked={notifyOnOrder}
                />
                <span class="toggle-switch" aria-hidden="true"></span>
              </label>
              <label class="toggle-item">
                <span class="toggle-item__label">Provisioning issue detected</span>
                <input
                  type="checkbox"
                  class="toggle-checkbox"
                  name="notify_on_provisioning"
                  checked={notifyOnProvisioning}
                />
                <span class="toggle-switch" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>

        <hr class="db-divider" />

        <div class="form-footer">
          <button type="submit" class="db-btn db-btn--primary">Save notification settings</button>
          <span class="db-text-xs db-text-muted">Settings are saved to the admin_settings table in Supabase.</span>
        </div>
      </form>
    </div>
  </div>

  <!-- API Key Management -->
  <div class="db-section">
    <h3 class="db-section-title">GoDaddy API Keys</h3>
    <div class="db-card">
      <div class="settings-row settings-row--stacked">
        <div class="settings-row__info">
          <h4 class="settings-row__label">API Key</h4>
          <p class="settings-row__desc">
            Your GoDaddy reseller API key. Only the last 4 characters are shown here for security.
            The full key is stored in your server environment variables as <code>GODADDY_API_KEY</code>.
          </p>
        </div>
        <div class="settings-row__control">
          <div class="api-key-display">
            <code class="api-key-value">{maskedKey}</code>
            <span class="db-badge {rawApiKey ? 'db-badge--active' : 'db-badge--expiring'}">
              {rawApiKey ? 'Configured' : 'Not set'}
            </span>
          </div>
          <p class="db-help-text db-mt-4">
            To rotate your API key, generate a new key in the
            <a href="https://developer.godaddy.com/keys" target="_blank" rel="noopener" class="settings-link">GoDaddy Developer Portal</a>
            and update your server's <code>.env</code> file or hosting environment variables.
            Auth format: <code>sso-key APIKEY:APISECRET</code> (plaintext — not base64).
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Support footer -->
  <div class="support-footer db-mt-6">
    <span class="db-text-muted db-text-xs">
      GoDaddy reseller support:
      <a href="tel:+14806242500" class="support-link">(480) 624-2500</a>
    </span>
  </div>
</DashboardLayout>

<script>
  const form = document.getElementById('notifications-form') as HTMLFormElement;
  const toast = document.getElementById('save-toast') as HTMLDivElement;

  function showToast(msg: string, type: 'success' | 'error' = 'success') {
    toast.textContent = msg;
    toast.className = `save-toast save-toast--${type}`;
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 3500);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    const payload: Record<string, string> = {
      notify_email: (data.get('notify_email') as string)?.trim() ?? '',
      notify_on_order: data.has('notify_on_order') ? 'true' : 'false',
      notify_on_provisioning: data.has('notify_on_provisioning') ? 'true' : 'false',
    };

    try {
      // Save each setting to admin_settings via Supabase
      // In production, this would call a dedicated PATCH /api/admin/settings endpoint.
      // For now, we show a success message and indicate manual Supabase update if needed.
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        showToast('Notification settings saved.');
      } else {
        // Endpoint may not exist yet — still give feedback
        showToast('Settings noted. Verify in Supabase admin_settings table.', 'error');
      }
    } catch {
      showToast('Settings noted locally. Verify in Supabase admin_settings table.', 'error');
    }
  });
</script>

<style>
  .settings-row {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2rem;
    align-items: start;
  }

  .settings-row--stacked {
    grid-template-columns: 1fr 1.5fr;
  }

  .settings-row__label {
    font-family: var(--db-font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--db-text-primary);
    margin: 0 0 0.375rem;
  }

  .settings-row__desc {
    font-size: 0.8125rem;
    color: var(--db-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .settings-row__control code {
    font-family: var(--db-font-mono);
    font-size: 0.78rem;
    background: var(--db-bg-input);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--db-violet-light);
  }

  /* Phone display */
  .phone-display {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .phone-number {
    font-family: var(--db-font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--db-status-active);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .phone-number:hover { text-decoration: underline; }

  /* API key */
  .api-key-display {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .api-key-value {
    font-family: var(--db-font-mono);
    font-size: 0.9rem;
    color: var(--db-text-secondary);
    background: var(--db-bg-input);
    padding: 0.375rem 0.75rem;
    border-radius: var(--db-radius);
    border: 1px solid var(--db-border-input);
    letter-spacing: 0.05em;
  }

  /* Toggle switches */
  .toggle-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .toggle-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    gap: 1rem;
  }

  .toggle-item__label {
    font-size: 0.875rem;
    color: var(--db-text-primary);
  }

  .toggle-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-switch {
    position: relative;
    width: 40px;
    height: 22px;
    background: var(--db-bg-input);
    border: 1px solid var(--db-border-input);
    border-radius: 9999px;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .toggle-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: var(--db-text-muted);
    border-radius: 50%;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .toggle-checkbox:checked + .toggle-switch {
    background: var(--db-violet);
    border-color: var(--db-violet);
  }

  .toggle-checkbox:checked + .toggle-switch::after {
    transform: translateX(18px);
    background: #fff;
  }

  .toggle-checkbox:focus-visible + .toggle-switch {
    outline: 2px solid var(--db-violet);
    outline-offset: 2px;
  }

  /* Form footer */
  .form-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Settings link */
  .settings-link {
    color: var(--db-violet-light);
    text-decoration: none;
  }

  .settings-link:hover { text-decoration: underline; }

  /* Toast notification */
  .save-toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    padding: 0.625rem 1.125rem;
    border-radius: var(--db-radius);
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 9999;
    box-shadow: var(--db-shadow-lg);
  }

  .save-toast--success {
    background: var(--db-status-active-bg);
    border: 1px solid var(--db-status-active);
    color: var(--db-status-active);
  }

  .save-toast--error {
    background: var(--db-status-warning-bg);
    border: 1px solid var(--db-status-warning);
    color: var(--db-status-warning);
  }

  /* Support footer */
  .support-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .support-link {
    color: var(--db-violet-light);
    text-decoration: none;
    font-weight: 500;
  }

  .support-link:hover { text-decoration: underline; }

  @media (max-width: 767px) {
    .settings-row,
    .settings-row--stacked {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
