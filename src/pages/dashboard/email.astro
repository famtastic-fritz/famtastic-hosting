---
/**
 * /dashboard/email — Email management page
 *
 * Shows email products from order history with links to GoDaddy's
 * Workspace Email and webmail. Full email management (adding/removing
 * mailboxes, quotas) requires GoDaddy Workspace Email API with per-shopper
 * OAuth — links provided instead.
 */
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ContactPhone from '../../components/dashboard/ContactPhone.svelte';

// Auth handled by Astro middleware — user available via Astro.locals.user
const user = Astro.locals.user as { id: string; email: string; role: string };

const origin = new URL(Astro.request.url).origin;

let emailProducts: any[] = [];
let links = {
  webmail: 'https://login.secureserver.net/',
  manage: 'https://account.godaddy.com/products',
  addEmail: 'https://www.secureserver.net/email-hosting/',
};
let fetchError = false;

try {
  const res = await fetch(`${origin}/api/customer/email`, {
    headers: { Cookie: Astro.request.headers.get('Cookie') ?? '' },
  });
  if (res.ok) {
    const data = await res.json();
    emailProducts = data?.data?.emailProducts ?? [];
    links = data?.data?.links ?? links;
  }
} catch (err) {
  fetchError = true;
  console.error('[dashboard/email] SSR fetch failed:', err);
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric'
  });
}
---

<DashboardLayout
  title="Email"
  variant="customer"
  currentPath="/dashboard/email"
  userName={user.email}
  userId={Number(user.id)}
>
  <div class="db-page-header">
    <div class="db-page-header__row">
      <div>
        <h1 class="db-page-title">Email Management</h1>
        <p class="db-page-subtitle">
          Access webmail, manage accounts, and add new email addresses.
        </p>
      </div>
      <div class="header-right">
        <ContactPhone variant="inline" client:load />
        <a
          href={links.addEmail}
          class="db-btn db-btn--primary db-btn--sm"
          target="_blank"
          rel="noopener"
        >
          + Add Email Account
        </a>
      </div>
    </div>
  </div>

  {fetchError && (
    <div class="db-alert db-alert--warning">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      <span>Unable to load email data. Refresh or call <a href="tel:+14806242500">(480) 624-2500</a>.</span>
    </div>
  )}

  <!-- Quick access row -->
  <section class="db-section" aria-labelledby="quicklinks-heading">
    <h2 id="quicklinks-heading" class="db-section-title">Quick Access</h2>
    <div class="quick-access-grid">
      <!-- Webmail -->
      <a href={links.webmail} class="quick-access-card" target="_blank" rel="noopener">
        <div class="quick-access-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <div class="quick-access-card__title">Webmail</div>
          <div class="quick-access-card__desc">Read and send email in browser</div>
        </div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="quick-access-card__arrow" aria-hidden="true">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>

      <!-- Manage accounts -->
      <a href={links.manage} class="quick-access-card" target="_blank" rel="noopener">
        <div class="quick-access-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M6.34 17.66l-1.41 1.41M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M12 2v2M12 20v2"/>
          </svg>
        </div>
        <div>
          <div class="quick-access-card__title">Manage Accounts</div>
          <div class="quick-access-card__desc">Add, remove, and configure mailboxes</div>
        </div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="quick-access-card__arrow" aria-hidden="true">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>

      <!-- Add email account -->
      <a href={links.addEmail} class="quick-access-card" target="_blank" rel="noopener">
        <div class="quick-access-card__icon quick-access-card__icon--violet" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <line x1="12" y1="10" x2="12" y2="16"/><line x1="9" y1="13" x2="15" y2="13"/>
          </svg>
        </div>
        <div>
          <div class="quick-access-card__title">Add Email Address</div>
          <div class="quick-access-card__desc">Professional email from $3/mo</div>
        </div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="quick-access-card__arrow" aria-hidden="true">
          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Email products from order history -->
  {emailProducts.length > 0 && (
    <section class="db-section" aria-labelledby="products-heading">
      <h2 id="products-heading" class="db-section-title">Email Products ({emailProducts.length})</h2>
      <div class="db-card db-card--flush">
        <table class="db-table" aria-label="Email products">
          <thead>
            <tr>
              <th>Product</th>
              <th>Order #</th>
              <th>Purchased</th>
              <th>Period</th>
              <th>Price/Unit</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {emailProducts.map((ep: any) => (
              <tr>
                <td class="db-text-primary">{ep.label}</td>
                <td class="db-text-mono db-text-sm db-text-muted">#{ep.orderId}</td>
                <td class="db-text-sm">{formatDate(ep.purchasedAt)}</td>
                <td class="db-text-sm db-text-muted">
                  {ep.period && ep.periodUnit
                    ? `${ep.period} ${ep.periodUnit.toLowerCase()}${ep.period > 1 ? 's' : ''}`
                    : '—'}
                </td>
                <td class="db-text-mono db-text-sm">${ep.unitPriceUSD?.toFixed(2) ?? '—'}</td>
                <td>
                  <a href={links.manage} class="db-btn db-btn--sm db-btn--secondary" target="_blank" rel="noopener">
                    Manage
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- API limitation notice -->
  <div class="db-alert db-alert--info" style="margin-top:var(--db-sp-4);">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <span>
      Individual mailbox details and quota usage are managed through the email control panel.
      Click "Manage Accounts" above or <a href="/dashboard/support">contact support</a> for setup assistance.
    </span>
  </div>

  <!-- Support CTA -->
  <div class="support-strip">
    <span class="support-strip__label">Need help setting up email?</span>
    <ContactPhone variant="inline" client:load />
  </div>
</DashboardLayout>

<style>
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--db-sp-3);
    flex-wrap: wrap;
  }

  /* Quick access grid */
  .quick-access-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--db-sp-4);
  }

  .quick-access-card {
    display: flex;
    align-items: center;
    gap: var(--db-sp-4);
    background: var(--db-bg-card);
    border: 1px solid var(--db-border);
    border-radius: var(--db-radius-lg);
    padding: var(--db-sp-4) var(--db-sp-5);
    text-decoration: none;
    transition: border-color var(--db-transition-fast), background var(--db-transition-fast);
  }

  .quick-access-card:hover {
    border-color: var(--db-border-light);
    background: var(--db-bg-card-hover);
  }

  .quick-access-card__icon {
    width: 44px;
    height: 44px;
    background: rgba(255,255,255,0.04);
    border-radius: var(--db-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--db-text-secondary);
    flex-shrink: 0;
  }

  .quick-access-card__icon--violet {
    background: var(--db-violet-dim);
    color: var(--db-violet-light);
  }

  .quick-access-card__title {
    font-family: var(--db-font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--db-text-primary);
    margin-bottom: 2px;
  }

  .quick-access-card__desc {
    font-size: 0.8125rem;
    color: var(--db-text-muted);
  }

  .quick-access-card__arrow {
    margin-left: auto;
    color: var(--db-text-muted);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity var(--db-transition-fast);
  }

  .quick-access-card:hover .quick-access-card__arrow {
    opacity: 1;
  }

  /* Support strip */
  .support-strip {
    display: flex;
    align-items: center;
    gap: var(--db-sp-4);
    margin-top: var(--db-sp-6);
    padding: var(--db-sp-4) var(--db-sp-5);
    background: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: var(--db-radius-lg);
    flex-wrap: wrap;
  }

  .support-strip__label {
    font-size: 0.9375rem;
    color: var(--db-text-secondary);
  }

  @media (max-width: 640px) {
    .header-right { flex-direction: column; align-items: flex-start; }
  }
</style>
